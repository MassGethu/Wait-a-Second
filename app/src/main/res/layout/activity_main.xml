<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include layout="@layout/screen_home" />
        <include layout="@layout/screen_statistics" />
        <include layout="@layout/screen_focus_reset" />
    </FrameLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_border"/>
    <LinearLayout android:id="@+id/mainNavigation" android:layout_width="match_parent" android:layout_height="76dp"
        android:orientation="horizontal" android:paddingHorizontal="24dp" android:paddingVertical="10dp"
        android:background="@color/surface_inset">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/navHome" style="@style/Focus.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:background="@drawable/bg_nav_item" android:drawableStart="@drawable/ic_home"
            android:drawablePadding="8dp" android:paddingHorizontal="12dp" android:textSize="14sp" android:text="@string/nav_home"/>
        <Space android:layout_width="12dp" android:layout_height="1dp"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/navStatistics" style="@style/Focus.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:background="@drawable/bg_nav_item" android:drawableStart="@drawable/ic_chart"
            android:drawablePadding="8dp" android:paddingHorizontal="12dp" android:textSize="14sp" android:text="@string/nav_statistics"/>
    </LinearLayout>
</LinearLayout>
