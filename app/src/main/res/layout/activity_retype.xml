<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/retypeRoot" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/Focus.Text.Title" android:layout_marginTop="48dp" android:text="@string/retype_title"/>
    <TextView android:id="@+id/retypeSentence" style="@style/Focus.Text.Section" android:layout_marginTop="24dp"/>
    <com.example.waitasecond.ui.retype.RetypeInput android:id="@+id/retypeInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:saveEnabled="false" android:hint="@string/retype_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
    <TextView android:id="@+id/retypeFeedback" style="@style/Focus.Text.Body" android:layout_marginTop="12dp"/>
    <Button android:id="@+id/retypeContinue" style="@style/Focus.PrimaryButton" android:layout_marginTop="24dp" android:enabled="false" android:text="@string/continue_anyway"/>
</LinearLayout>
</ScrollView>
