<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:text="@string/dm_checkin_prompt"
        android:textColor="@color/text_primary"
        android:textAppearance="?attr/textAppearanceSubtitle1" />

    <TextView
        android:id="@+id/dmGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textAppearance="?attr/textAppearanceBody2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dmRelevant"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue"
            android:text="@string/dm_work" />

        <Button
            android:id="@+id/dmPersonal"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue"
            android:text="@string/dm_personal" />
    </LinearLayout>

    <Button
        android:id="@+id/dmReturn"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0"
        android:textAllCaps="false"
        android:textColor="@color/accent_blue"
        android:text="@string/dm_return" />
</LinearLayout>
