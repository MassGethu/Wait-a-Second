<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="24dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Focus.Text.Eyebrow" android:text="@string/brand_eyebrow" android:textColor="@color/accent_blue"/>
                <TextView style="@style/Focus.Text.Title" android:text="@string/study_focus" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon"
                android:padding="11dp" android:src="@drawable/ic_focus" android:importantForAccessibility="no"/>
        </LinearLayout>
        <TextView style="@style/Focus.Text.Body" android:text="@string/focus_subtitle" android:layout_marginTop="8dp"/>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Focus.Text.Eyebrow" android:text="@string/current_topic"/>
                <TextView android:id="@+id/topicValue" style="@style/Focus.Text.Section" android:layout_marginTop="7dp" android:text="@string/default_topic"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/editTopicButton" style="@style/Focus.TextButton"
                android:layout_width="64dp" android:text="@string/edit_topic"/>
        </LinearLayout>
        <com.example.waitasecond.FocusTimerView android:id="@+id/focusTimer" android:layout_width="match_parent"
            android:layout_height="292dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
            android:contentDescription="@string/timer_description"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/durationButton" style="@style/Focus.TextButton"
            android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/duration_default"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/startSessionButton" style="@style/Focus.PrimaryButton"
            android:layout_marginTop="8dp" android:text="@string/start_focus_session"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/endSessionButton" style="@style/Focus.SecondaryButton"
            android:layout_marginTop="8dp" android:visibility="gone" android:text="@string/end_session"/>
        <TextView android:id="@+id/sessionHint" style="@style/Focus.Text.Body" android:layout_width="match_parent"
            android:gravity="center" android:layout_marginTop="12dp" android:textSize="12sp" android:text="@string/ready_hint"/>
        <LinearLayout style="@style/Focus.Card" android:orientation="horizontal" android:padding="16dp" android:layout_marginTop="24dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/studyTimeValue" style="@style/Focus.Text.Section" android:text="@string/zero_minutes"/>
                <TextView style="@style/Focus.Text.Body" android:textSize="11sp" android:text="@string/study_time" android:layout_marginTop="6dp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/surface_border"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/attemptValue" style="@style/Focus.Text.Section" android:text="@string/zero_count"/>
                <TextView style="@style/Focus.Text.Body" android:textSize="11sp" android:text="@string/attempts" android:layout_marginTop="6dp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/surface_border"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/redirectValue" style="@style/Focus.Text.Section" android:text="@string/zero_count" android:textColor="@color/accent_mint"/>
                <TextView style="@style/Focus.Text.Body" android:textSize="11sp" android:text="@string/redirected" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Focus.Text.Body" android:text="@string/session_data_note" android:textSize="11sp" android:layout_marginTop="8dp"/>
        <TextView style="@style/Focus.Text.Section" android:text="@string/study_plan" android:layout_marginTop="28dp"/>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="14dp" android:padding="12dp">
            <CheckBox android:id="@+id/planRead" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:buttonTint="@color/accent_blue" android:textColor="@color/text_secondary" android:text="@string/plan_read"/>
            <CheckBox android:id="@+id/planPractice" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:buttonTint="@color/accent_blue" android:textColor="@color/text_secondary" android:text="@string/plan_practice"/>
            <CheckBox android:id="@+id/planRevision" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:buttonTint="@color/accent_blue" android:textColor="@color/text_secondary" android:text="@string/plan_revision"/>
        </LinearLayout>
        <TextView style="@style/Focus.Text.Section" android:text="@string/tracked_apps" android:layout_marginTop="28dp"/>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="14dp" android:padding="14dp">
            <com.example.waitasecond.TrackedAppView android:id="@+id/trackedYoutube" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="4dp" android:background="@color/surface_border"/>
            <com.example.waitasecond.TrackedAppView android:id="@+id/trackedInstagram" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/monitoringButton" style="@style/Focus.TextButton"
            android:layout_marginTop="8dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/enable_monitoring"/>
    </LinearLayout>
</ScrollView>
