<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statisticsPage" android:layout_width="match_parent" android:layout_height="match_parent"
    android:visibility="gone" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="24dp" android:paddingBottom="24dp">
        <TextView style="@style/Focus.Text.Eyebrow" android:text="@string/awareness_eyebrow" android:textColor="@color/accent_blue"/>
        <TextView style="@style/Focus.Text.Title" android:text="@string/nav_statistics" android:layout_marginTop="8dp"/>
        <TextView style="@style/Focus.Text.Body" android:text="@string/statistics_subtitle" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/statisticsScope" style="@style/Focus.Text.Body" android:layout_marginTop="20dp"
            android:paddingHorizontal="14dp" android:paddingVertical="9dp" android:background="@drawable/bg_icon" android:text="@string/today"/>
        <Spinner android:id="@+id/statisticsPeriod" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_inset" android:contentDescription="@string/select_statistics_period"/>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="16dp">
            <TextView style="@style/Focus.Text.Section" android:text="@string/weekly_focus"/>
            <TextView android:id="@+id/weeklyFocusTotal" style="@style/Focus.Text.Title" android:layout_marginTop="8dp" android:text="@string/zero_minutes"/>
            <TextView style="@style/Focus.Text.Body" android:text="@string/period_focus_time" android:textSize="12sp"/>
            <com.example.waitasecond.ui.statistics.WeeklyFocusChartView android:id="@+id/weeklyFocusChart"
                android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="18dp"/>
            <TextView android:id="@+id/modeUsage" style="@style/Focus.Text.Body" android:layout_width="match_parent" android:textSize="12sp" android:layout_marginTop="12dp"/>
        </LinearLayout>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="20dp">
            <TextView style="@style/Focus.Text.Body" android:text="@string/screen_time"/>
            <TextView android:id="@+id/screenTimeTotal" style="@style/Focus.Text.Title" android:layout_marginTop="8dp" android:text="@string/zero_minutes"/>
            <TextView style="@style/Focus.Text.Body" android:textSize="12sp" android:text="@string/monitored_time_note" android:layout_marginTop="4dp"/>
            <com.example.waitasecond.ui.components.AppTimeChartView android:id="@+id/screenTimeChart" android:layout_width="match_parent"
                android:layout_height="164dp" android:layout_marginTop="18dp" android:contentDescription="@string/screen_time_chart"/>
        </LinearLayout>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="16dp">
            <TextView style="@style/Focus.Text.Section" android:text="@string/short_video_title" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/shortVideoOptIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:text="@string/short_video_opt_in" />
            <TextView android:id="@+id/shortVideoStatus" style="@style/Focus.Text.Body" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/shortVideoBadgeOptIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:text="@string/short_video_badge_opt_in"
                android:visibility="gone" />
            <TextView android:id="@+id/shortVideoToday" style="@style/Focus.Text.Body" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/shortVideoSession" style="@style/Focus.Text.Body" android:layout_marginTop="8dp" />
            <TextView style="@style/Focus.Text.Body" android:layout_marginTop="8dp" android:textSize="12sp"
                android:text="@string/short_video_measurement" />
        </LinearLayout>
        <LinearLayout style="@style/Focus.Card" android:background="@drawable/bg_accent_card" android:layout_marginTop="16dp">
            <TextView style="@style/Focus.Text.Eyebrow" android:text="@string/distraction_attempts_title" android:textColor="@color/accent_purple"/>
            <TextView android:id="@+id/statsAttemptValue" style="@style/Focus.Text.Title" android:textSize="48sp"
                android:layout_marginTop="10dp" android:text="@string/zero_count"/>
            <TextView android:id="@+id/attemptSummary" style="@style/Focus.Text.Body" android:layout_width="match_parent" android:layout_marginTop="4dp" android:text="@string/no_distractions"/>
            <TextView android:id="@+id/redirectSummary" style="@style/Focus.Text.Body" android:layout_width="match_parent"
                android:layout_marginTop="14dp" android:textColor="@color/accent_mint"/>
        </LinearLayout>
        <TextView style="@style/Focus.Text.Section" android:text="@string/distraction_sources" android:layout_marginTop="28dp"/>
        <LinearLayout style="@style/Focus.Card" android:layout_marginTop="14dp" android:padding="14dp">
            <com.example.waitasecond.ui.components.TrackedAppView android:id="@+id/statsYoutube" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="4dp" android:background="@color/surface_border"/>
            <com.example.waitasecond.ui.components.TrackedAppView android:id="@+id/statsInstagram" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/sourceInsight" style="@style/Focus.Text.Body" android:layout_width="match_parent"
            android:padding="16dp" android:layout_marginTop="14dp" android:background="@drawable/bg_inset"/>
        <TextView style="@style/Focus.Text.Section" android:text="@string/recent_activity_label" android:layout_marginTop="28dp"/>
        <TextView android:id="@+id/recentActivity" style="@style/Focus.Text.Body" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:padding="20dp" android:lineSpacingExtra="10dp" android:text="@string/no_recent_activity"/>
        <TextView style="@style/Focus.Text.Body" android:layout_width="match_parent" android:layout_marginTop="18dp"
            android:textSize="11sp" android:text="@string/statistics_limits"/>
        <TextView android:id="@+id/dmCheckinCounts" style="@style/Focus.Text.Body" android:layout_marginTop="16dp" android:text="@string/dm_stats_empty"/>
    </LinearLayout>
</ScrollView>
